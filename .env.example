# Copy to .env or export variables before running Docker Compose commands.
# Docker Compose mounts ~/.shacs-bot into /home/shacs/.shacs-bot, so prefer
# adding provider/channel credentials to ~/.shacs-bot/config.json after onboard.

RUST_LOG=info

# Optional: match container process ownership to your host user.
# SHACS_UID=1000
# SHACS_GID=1000

# Optional provider secrets if your config.json references environment variables.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
CODEX_TOKEN=
TAVILY_API_KEY=

# Optional channel secrets if config.json references environment variables.
SHACS_EMAIL_SMTP_PASSWORD=
SHACS_EMAIL_IMAP_PASSWORD=
