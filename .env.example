# Copy to .env or export variables before running Docker Compose commands.
# Docker Compose mounts ~/.shacs-bot into /home/shacs/.shacs-bot. Keep
# provider/channel secrets out of config.json: put them in
# ~/.shacs-bot/.env.json ({"NAME": "value"}, chmod 600) and write "${NAME}" in
# config.json, or write them in config.json once and run
# `docker compose run --rm shacs-cli runtime config-migrate --apply` to move
# them. "${NAME}" uses a non-empty variable below first, then .env.json; the
# variables left empty here do not hide .env.json there.
#
# A provider reads its own variable below (ANTHROPIC_API_KEY, ...) before
# auth.json and config, even when it is empty, so an empty provider variable
# makes that provider send requests without a key even if auth.json or
# config (.env.json included) holds one. To use such a provider in Docker,
# put its key here, or sign in with a ChatGPT account:
# `docker compose run --rm shacs-cli provider codex login --headless`.
# `docker compose run --rm shacs-cli provider status` shows which provider
# the runtime picks and whether its credential is where the runtime reads it.

RUST_LOG=info

# Optional: match container process ownership to your host user.
# SHACS_UID=1000
# SHACS_GID=1000

# Optional provider secrets if your config.json references environment variables.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
CODEX_TOKEN=
TAVILY_API_KEY=

# Optional channel secrets if config.json references environment variables.
SHACS_EMAIL_SMTP_PASSWORD=
SHACS_EMAIL_IMAP_PASSWORD=
